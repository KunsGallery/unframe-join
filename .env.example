# Existing Vite Firebase client variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (use either the JSON variable or the three split variables)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Existing Solapi settings
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=

# SALON-specific approved Kakao template IDs
SOLAPI_SALON_APPROVAL_TEMPLATE_ID=
SOLAPI_SALON_WELCOME_TEMPLATE_ID=

# 32+ byte secret used to reconstruct an existing pass for notification resend
SALON_QR_TOKEN_SECRET=

# Shared server-to-server secret used by salon.unframe.kr to confirm check-in
SALON_CHECKIN_SHARED_SECRET=

# Cloudflare R2. The public bucket holds posters and site images; applicant files
# (open call portfolios and artwork images) go to the private bucket once it is set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET_NAME=
